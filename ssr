#!/usr/bin/env python3
"""
Termux Screen Reader berbasis PTY dan pyte.
Dioptimalkan untuk aksesibilitas mandiri, navigasi tingkat lanjut, dan interaksi TUI.

Berkas ini HANYA menangani logika utama pembaca layar: pembuatan PTY,
menjalankan shell anak, parsing buffer terminal lewat pyte, deteksi mode
editor/TUI, serta navigasi (mode penjelajahan, umpan balik ketikan, dst).

Segala sesuatu yang berkaitan dengan SUARA (deteksi mesin eSpeak, eksekusi
proses TTS, pemetaan simbol ke ucapan) dipisahkan ke modul speech.py di
direktori yang sama (lihat SpeechEngine) -- lihat konfigurasi SSR_VOICE
dan SSR_RATE di sana.
"""

import os
import sys
import struct
import pty
import termios
import tty
import select
import signal
import re
import fcntl
from typing import Tuple, Optional, List, Any

import pyte

# Modul suara (TTS) dipisah ke speech.py, disimpan di direktori yang sama
# dengan skrip ini (root proyek) -- bukan di direktori kerja (CWD) saat ini,
# supaya ssr tetap bisa menemukan speech.py meski dijalankan dari lokasi
# mana pun (mis. lewat symlink di PATH, atau `python3 /path/ke/ssr`).
_PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))
if _PROJECT_ROOT not in sys.path:
    sys.path.insert(0, _PROJECT_ROOT)

from speech import SpeechEngine, strip_escapes


class _CapturingScreen(pyte.Screen):
    """Screen kustom yang menangkap setiap baris yang tergeser (scroll)
    keluar dari layar SEBELUM hilang.

    Bug yang diperbaiki: sebelumnya pembacaan output shell hanya menebak
    baris mana yang "baru" berdasarkan posisi kursor sebelum/sesudah satu
    potongan data diproses. Begitu output lebih panjang dari tinggi layar
    (sangat umum: `ls` direktori besar, `cat` file panjang, `pip list`,
    dst), layar akan SCROLL -- kursor tetap "menempel" di baris paling
    bawah sementara baris-baris di atasnya bergeser ke atas dan hilang dari
    buffer, sehingga sebagian besar isi output tidak pernah ikut terbaca
    ("beberapa output tidak otomatis dibacakan").

    pyte sendiri memakai teknik yang sama persis pada HistoryScreen bawaannya
    (menangkap baris paling atas tepat sebelum di-scroll via method index()).
    Di sini kita pakai teknik serupa, versi ringan, khusus untuk kebutuhan
    "baca sekali lalu buang" -- bukan scrollback penuh dengan paging.
    """

    def __init__(self, *args, **kwargs) -> None:
        super().__init__(*args, **kwargs)
        self.scrolled_lines: List[str] = []

    def _row_text(self, row) -> str:
        return "".join(
            row[x].data if x in row else " " for x in range(self.columns)
        ).rstrip()

    def index(self) -> None:
        try:
            top, bottom = self.margins if self.margins else (0, self.lines - 1)
            if self.cursor.y == bottom:
                row = self.buffer.get(top)
                if row:
                    text = self._row_text(row)
                    if text:
                        self.scrolled_lines.append(text)
        except Exception:
            # Jangan sampai penangkapan baris yang di-scroll mematahkan
            # emulasi terminal utama bila struktur internal pyte berbeda
            # antar versi -- lebih baik kehilangan peningkatan ini daripada
            # membuat seluruh pembaca layar crash.
            pass
        super().index()


class TermuxScreenReader:
    """Emulator terminal pembaca layar lisan yang menggunakan eSpeak dan pyte."""

    PROMPT_INDICATORS: Tuple[str, ...] = ('$', '#', '>', '%', ']', ')')
    # Pola prompt REPL yang umum (Python, dsb) yang tidak tertangkap oleh
    # daftar indikator satu-karakter di atas.
    PROMPT_SUFFIXES: Tuple[str, ...] = ('>>>', '...')

    def __init__(self) -> None:
        self.cols, self.rows = self._get_terminal_size()
        self.screen = _CapturingScreen(self.cols, self.rows)
        self.stream = pyte.Stream(self.screen)

        self.review_mode: bool = False
        self.rx: int = 0
        self.ry: int = 0

        self.editor_mode: bool = False
        self._last_editor_cursor_y: int = -1
        self._last_editor_cursor_x: int = -1
        # Baris yang sedang disorot (reverse-video) pada dialog TUI seperti
        # whiptail/dialog (mis. termux-change-repo). Banyak dialog semacam
        # itu TIDAK memindahkan kursor asli saat item daftar berpindah --
        # hanya warnanya yang berubah -- sehingga deteksi berbasis posisi
        # kursor saja tidak akan pernah membacakan apa pun saat navigasi.
        self._last_highlighted_row: Optional[int] = None
        # Penghitung "kredit" umpan balik ketikan yang SUDAH dibacakan
        # langsung saat tombol ditekan (lihat _feedback_keystroke), supaya
        # update_buffer() tidak membacakannya lagi secara keliru (lihat
        # catatan di update_buffer soal bug "hanya membaca spasi").
        self._typed_feedback_pending: int = 0
        # Mode Pengaturan (Ctrl+S) -- fitur diagnosis/uji coba: memungkinkan
        # pengguna memaksa masuk/keluar mode interaktif SECARA MANUAL lewat
        # tombol 'E', tanpa menunggu deteksi otomatis alternate-screen-buffer
        # (_detect_editor) dari perubahan layar terminal. Lihat handle_input
        # dan _toggle_editor_mode_manual().
        self.setting_mode: bool = False
        # Buffer sisa (carry-over) untuk _detect_editor -- lihat catatan
        # lengkap di sana soal sekuens escape yang bisa terpotong tepat di
        # batas antar potongan data dari PTY.
        self._editor_detect_carry: str = ""

        # Seluruh urusan suara (TTS) ditangani modul terpisah speech.py --
        # lihat komentar impor di atas berkas ini.
        self.speech = SpeechEngine()

        self.last_prompt: str = ""
        self._last_spoken_line: str = ""

        # Terisi setelah PTY & proses anak (shell) dibuat di run().
        self.master_fd: Optional[int] = None
        self.child_pid: Optional[int] = None

        signal.signal(signal.SIGWINCH, self._handle_resize)

    # ----------------------------------------------------------------------
    # Terminal & Manajemen Ukuran Layar
    # ----------------------------------------------------------------------
    @staticmethod
    def _get_terminal_size() -> Tuple[int, int]:
        """Mendapatkan resolusi kolom dan baris terminal secara aman."""
        try:
            buf = struct.pack("HHHH", 0, 0, 0, 0)
            buf = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, buf)
            rows, cols, _, _ = struct.unpack("HHHH", buf)
            if cols > 0 and rows > 0:
                return cols, rows
        except (AttributeError, OSError):
            pass

        try:
            size = os.get_terminal_size()
            return size.columns, size.lines
        except OSError:
            return 80, 24

    def _set_pty_size(self, fd: int) -> None:
        """Menyalin resolusi layar kita saat ini ke jendela PTY milik shell anak."""
        try:
            size = struct.pack("HHHH", self.rows, self.cols, 0, 0)
            fcntl.ioctl(fd, termios.TIOCSWINSZ, size)
        except OSError:
            pass

    def _handle_resize(self, signum: int, frame: Optional[Any]) -> None:
        """Menyesuaikan resolusi internal pyte saat ukuran jendela berubah.

        PENTING: sebelumnya fungsi ini hanya mengubah ukuran buffer pyte kita
        sendiri, tanpa pernah memberitahu proses shell anak (lewat PTY) bahwa
        ukuran jendela berubah. Akibatnya program seperti vim/htop/less akan
        salah membungkus baris atau salah menggambar ulang layar setelah
        jendela di-resize. Sekarang kita juga mempropagasikan ukuran baru ke
        PTY (TIOCSWINSZ) dan mengirim SIGWINCH ke proses anak, persis seperti
        yang dilakukan terminal emulator sungguhan.
        """
        self.cols, self.rows = self._get_terminal_size()
        try:
            self.screen.resize(self.rows, self.cols)
        except Exception:
            pass

        if self.master_fd is not None:
            self._set_pty_size(self.master_fd)
            if self.child_pid:
                try:
                    os.kill(self.child_pid, signal.SIGWINCH)
                except ProcessLookupError:
                    pass

    # ----------------------------------------------------------------------
    # Interaksi Buffer Pyte & Utilitas
    # ----------------------------------------------------------------------
    def get_char_at(self, x: int, y: int) -> str:
        """Membaca satu karakter pada koordinat tertentu dari buffer terminal."""
        try:
            ch = self.screen.buffer[y][x].data
            return ch if ch else " "
        except (KeyError, IndexError):
            return " "

    def get_line_at(self, y: int) -> str:
        """Membaca baris penuh."""
        try:
            return "".join(
                self.screen.buffer[y][x].data for x in range(self.cols)
            ).rstrip()
        except (KeyError, IndexError):
            return ""

    def get_line_length(self, y: int) -> int:
        """Menghitung panjang visual sebenarnya dari baris."""
        return len(self.get_line_at(y))

    def get_word_at(self, x: int, y: int) -> str:
        """Mengekstrak kata penuh yang sedang disorot oleh kursor."""
        line = self.get_line_at(y)
        if not line or x >= len(line):
            return "kosong"

        # Mencari batas kiri
        start = x
        while start > 0 and not line[start - 1].isspace():
            start -= 1

        # Mencari batas kanan
        end = x
        while end < len(line) and not line[end].isspace():
            end += 1

        return line[start:end]

    def find_next_word_x(self, x: int, y: int) -> int:
        """Menemukan posisi X untuk kata berikutnya dalam satu baris."""
        line = self.get_line_at(y)
        if x >= len(line):
            return x

        # Melewati kata saat ini
        while x < len(line) and not line[x].isspace():
            x += 1
        # Melewati spasi
        while x < len(line) and line[x].isspace():
            x += 1

        return min(x, max(0, len(line) - 1))

    def find_prev_word_x(self, x: int, y: int) -> int:
        """Menemukan posisi X untuk kata sebelumnya dalam satu baris."""
        if x <= 0:
            return 0
        line = self.get_line_at(y)

        # Mundur melewati spasi
        x -= 1
        while x > 0 and x < len(line) and line[x].isspace():
            x -= 1
        # Mundur melewati kata
        while x > 0 and (x - 1) < len(line) and not line[x - 1].isspace():
            x -= 1

        return max(0, x)

    def _is_prompt(self, line: str) -> bool:
        """Heuristik penanda shell prompt.

        PENTING: fungsi ini HANYA boleh dipanggil untuk baris tempat kursor
        SEDANG berada saat ini (lihat pemanggilnya di update_buffer), bukan
        untuk sembarang baris output. Menerapkannya ke semua baris berisiko
        salah menganggap baris output BIASA yang kebetulan diakhiri salah
        satu karakter penanda ('$', '#', '%', ']', ')', '>') sebagai prompt
        lalu membuangnya -- misalnya baris keluaran `df -h` yang diakhiri
        angka persentase. Dengan membatasi hanya ke baris kursor saat ini,
        risiko salah-tangkap itu jauh berkurang.

        Bug yang diperbaiki: versi sebelumnya mensyaratkan ada SPASI persis
        setelah karakter penanda ("$ ", bukan "$"). Padahal baris yang
        diperiksa di sini selalu sudah melalui get_line_at(), yang selalu
        me-rstrip() hasilnya -- sehingga syarat spasi itu TIDAK PERNAH
        terpenuhi dan prompt nyaris tidak pernah terdeteksi sama sekali.
        """
        if not line:
            return False
        clean = strip_escapes(line).rstrip()
        if not clean or len(clean) > 200:
            return False

        for suffix in self.PROMPT_SUFFIXES:
            if clean == suffix or clean.endswith(suffix):
                return True

        for indicator in self.PROMPT_INDICATORS:
            if clean.endswith(indicator):
                return True
        return False

    # Pola gabungan untuk mendeteksi SETIAP kemunculan sekuens masuk ('h')
    # maupun keluar ('l') alternate-screen-buffer dalam satu potongan data,
    # lengkap dengan urutan kemunculannya -- lihat catatan di _detect_editor.
    _ALT_SCREEN_EVENT_RE = re.compile(r'\x1b\[\?(?:1049|47)([hl])')
    # Panjang sekuens TERPANJANG yang dicari ("\x1b[?1049h" = 8 karakter),
    # dilebihkan sedikit untuk jaga-jaga -- dipakai untuk ukuran buffer
    # carry-over, lihat _detect_editor.
    _ALT_SCREEN_CARRY_LEN = 12

    def _detect_editor(self, data: bytes) -> bool:
        """Mendeteksi penggunaan Alternate Screen Buffer (Mode TUI/Editor).

        Bug #1 yang diperbaiki (kondisi lomba dua event dalam satu chunk):
        versi sebelumnya memakai `if ... elif ...` untuk memeriksa
        KEBERADAAN sekuens masuk/keluar dalam satu potongan data -- hanya
        diperiksa SEKALI, bukan per kemunculan. Ini gagal pada wizard
        dialog seperti `termux-change-repo`, yang di baliknya menjalankan
        proses `whiptail` BARU untuk setiap layar (mis. saat berpindah dari
        pemilihan negara ke pemilihan mirror): sekuens "keluar
        alternate-screen" dari dialog lama dan "masuk alternate-screen"
        dari dialog baru bisa tiba BERSAMAAN dalam satu potongan data PTY
        yang sama. Sekarang setiap kemunculan sekuens diproses satu per
        satu SESUAI URUTAN kemunculannya di dalam data.

        Bug #2 yang diperbaiki (sekuens terpotong batas chunk -- INI
        penyebab UTAMA laporan "mode interaktif gagal setelah konfirmasi"):
        `os.read(master_fd, ...)` TIDAK menjamin satu "semburan" data dari
        PTY selalu utuh dalam satu panggilan read() -- kernel bisa memotong
        aliran byte di titik SEMBARANG, termasuk tepat di TENGAH sekuens
        escape 8-9 karakter seperti "\\x1b[?1049h". Tulisan AWAL (masuk
        mode interaktif pertama kali) biasanya kecil & terisolasi sehingga
        nyaris selalu utuh dalam satu potongan -- itulah kenapa masuk mode
        interaktif pertama kali nyaris selalu berhasil. Tapi transisi
        BERIKUTNYA (mis. redraw penuh dialog whiptail baru setelah
        konfirmasi) jauh lebih besar, sehingga jauh lebih mungkin terpotong
        tepat di batas 4096-byte buffer read() -- akibatnya sekuens
        "\\x1b[?1049h" untuk dialog BARU tidak pernah terdeteksi UTUH sama
        sekali, dan status macet di editor_mode=False sampai pengguna
        mengaktifkannya manual (Mode Pengaturan). Diperbaiki dengan
        menyambung sisa akhir potongan SEBELUMNYA ke depan potongan
        sekarang sebelum dicari (mirip cara pyte.Stream sendiri menangani
        potongan data yang terpotong), lalu menyimpan ekor baru untuk
        potongan berikutnya. Menyimpan sisa yang KEBETULAN sudah memuat
        sekuens utuh dari potongan sebelumnya aman (tidak menyebabkan efek
        ganda) karena diproses ulang lewat guard `not self.editor_mode` /
        `self.editor_mode` yang sudah ada -- pencocokan ulang sekuens yang
        sudah diproses hanya menjadi no-op.
        """
        try:
            text = data.decode('utf-8', errors='ignore')
        except UnicodeDecodeError:
            return False

        combined = self._editor_detect_carry + text
        self._editor_detect_carry = combined[-self._ALT_SCREEN_CARRY_LEN:]

        changed = False
        for match in self._ALT_SCREEN_EVENT_RE.finditer(combined):
            entering = match.group(1) == 'h'
            if entering and not self.editor_mode:
                self.editor_mode = True
                self._last_editor_cursor_y = self.screen.cursor.y
                self._last_editor_cursor_x = self.screen.cursor.x
                self._last_highlighted_row = None
                self._typed_feedback_pending = 0
                self.speech.speak("mode interaktif aktif", interrupt=True)
                changed = True
            elif not entering and self.editor_mode:
                self.editor_mode = False
                self._last_highlighted_row = None
                self._typed_feedback_pending = 0
                self.speech.speak("keluar dari mode interaktif", interrupt=True)
                changed = True
        return changed

    def _find_highlighted_row(self) -> Optional[int]:
        """Mencari baris yang sedang disorot pada dialog TUI (whiptail/dialog).

        Dialog seperti `whiptail`/`dialog` (dipakai mis. oleh
        termux-change-repo) menandai item daftar yang sedang dipilih tanpa
        memindahkan kursor terminal sungguhan ke baris tersebut -- kursor
        asli biasanya tetap diam di baris tombol OK/Batal. Ada DUA konvensi
        berbeda yang dipakai tema/skema warna berbeda-beda untuk menandai
        sorotan tsb, jadi keduanya diperiksa:

          1. Atribut SGR reverse-video (`\x1b[7m`) -- konvensi klasik/paling
             umum, dicek lebih dulu karena murah (boolean per sel).
          2. Perubahan warna LATAR (background) eksplisit -- beberapa tema
             dialog (mis. tema biru khas Debian/Termux) TIDAK memakai
             reverse-video sama sekali, melainkan mengubah warna latar item
             yang disorot menjadi warna berbeda (mis. dari abu-abu kotak
             dialog menjadi biru senada latar terminal), sambil warna teks
             berubah jadi kuning terang. Baris dengan warna latar yang
             berbeda dari warna latar "mayoritas" (dipakai baris-baris lain
             yang tidak disorot) dianggap sebagai baris yang disorot --
             pendekatan ini sengaja tidak menebak kode warna PERSIS (mis.
             hex tertentu), supaya tetap berfungsi di berbagai skema warna
             tema whiptail/dialog tanpa perlu hardcode warna spesifik.
        """
        reverse_row: Optional[int] = None
        bg_votes: dict = {}
        row_bg_counts: dict = {}

        for y in range(self.rows):
            row = self.screen.buffer.get(y)
            if not row:
                continue
            counts: dict = {}
            for cell in row.values():
                if cell.data in (' ', ''):
                    continue
                if reverse_row is None and getattr(cell, 'reverse', False):
                    reverse_row = y
                bg = getattr(cell, 'bg', 'default')
                counts[bg] = counts.get(bg, 0) + 1
                bg_votes[bg] = bg_votes.get(bg, 0) + 1
            if counts:
                row_bg_counts[y] = counts

        if reverse_row is not None:
            return reverse_row

        if not bg_votes:
            return None

        # Warna latar yang paling banyak dipakai di seluruh layar dialog
        # dianggap sebagai warna "normal" (item yang TIDAK disorot, border,
        # judul, dst). Sel dengan latar 'default' (tidak diwarnai sama
        # sekali) tidak relevan sebagai penanda sorotan, jadi diabaikan.
        baseline_bg = max(bg_votes, key=bg_votes.get)

        for y in range(self.rows):
            counts = row_bg_counts.get(y)
            if not counts:
                continue
            dominant_bg = max(counts, key=counts.get)
            if dominant_bg != baseline_bg and dominant_bg != 'default':
                return y

        return None

    # ----------------------------------------------------------------------
    # Pemrosesan Output Dinamis
    # ----------------------------------------------------------------------
    def update_buffer(self, raw_data: bytes) -> None:
        """Menyinkronkan output shell ke buffer virtual dan memberikan umpan balik suara."""
        try:
            text = raw_data.decode('utf-8', errors='replace')
        except UnicodeDecodeError:
            text = raw_data.decode('latin-1', errors='replace')

        pre_cursor_y = self.screen.cursor.y

        self._detect_editor(raw_data)
        self.stream.feed(text)

        # Baris yang tergeser keluar layar (scroll) selama feed() di atas --
        # lihat _CapturingScreen. Selalu dikuras di sini supaya tidak
        # menumpuk, terlepas dari mode aktif saat ini.
        scrolled_lines = self.screen.scrolled_lines
        if scrolled_lines:
            self.screen.scrolled_lines = []

        if self.review_mode:
            return

        current_y = self.screen.cursor.y
        current_x = self.screen.cursor.x

        if self.editor_mode:
            # 1) Dialog TUI (whiptail/dialog dkk.) menandai pilihan lewat
            #    reverse-video, bukan lewat memindahkan kursor asli. Cek ini
            #    dulu supaya navigasi daftar pada dialog seperti itu
            #    (mis. termux-change-repo) benar-benar terdengar.
            highlighted_row = self._find_highlighted_row()
            if highlighted_row is not None and highlighted_row != self._last_highlighted_row:
                self._last_highlighted_row = highlighted_row
                self._last_editor_cursor_y = current_y
                self._last_editor_cursor_x = current_x
                line = self.get_line_at(highlighted_row)
                self.speech.speak(line if line else "kosong", interrupt=True)
                return

            # 2) Kursor pindah baris (navigasi Atas/Bawah, Enter membuat
            #    baris baru, dst).
            if current_y != self._last_editor_cursor_y:
                self._last_editor_cursor_y = current_y
                self._last_editor_cursor_x = current_x
                self._typed_feedback_pending = 0
                line = self.get_line_at(current_y)
                self.speech.speak(line if line else "kosong", interrupt=True)
                return

            # 3) Kursor pindah kolom pada baris yang sama.
            if current_x != self._last_editor_cursor_x:
                jarak = abs(current_x - self._last_editor_cursor_x)
                self._last_editor_cursor_x = current_x

                if self._typed_feedback_pending > 0:
                    # PENTING (bug "hanya membaca spasi" saat mengetik di
                    # nano): karakter yang baru diketik/dihapus SUDAH
                    # dibacakan langsung saat tombol ditekan (lihat
                    # handle_input/_feedback_keystroke). Jangan dibacakan
                    # ulang di sini -- apalagi kolom kursor yang BARU
                    # (current_x) umumnya adalah sel yang masih KOSONG (satu
                    # kolom SETELAH huruf yang baru saja ditulis), sehingga
                    # sebelumnya kode ini nyaris selalu membacakan "spasi"
                    # untuk setiap huruf yang diketik.
                    self._typed_feedback_pending -= 1
                    return

                # Sampai di sini berarti perpindahan kursor BUKAN akibat
                # ketikan kita sendiri (mis. navigasi panah, atau aplikasi
                # memindahkan kursor secara internal) -- baca langsung sel
                # yang menjadi tujuan kursor, sama seperti versi sebelumnya.
                if jarak > 1:
                    word = self.get_word_at(current_x, current_y)
                    self.speech.speak(word, interrupt=True, pitch=60)
                else:
                    char = self.get_char_at(current_x, current_y)
                    self.speech.speak(char, interrupt=True, pitch=60, is_character=True)
            return

        # --- Mode shell biasa ---
        # Karakter yang sedang diketik sudah dibacakan huruf demi huruf oleh
        # _feedback_keystroke() saat tombol ditekan (lihat handle_input), jadi
        # di sini kita HANYA perlu membacakan baris yang benar-benar berasal
        # dari OUTPUT program (mis. hasil `ls`, `cat`, dst).
        #
        # Sebelumnya kode ini membaca ulang baris kursor setiap kali baris itu
        # berubah, termasuk untuk setiap huruf yang diketik pada perintah yang
        # sedang disusun -- akibatnya perintah dibacakan berulang-ulang huruf
        # demi huruf setiap kali bertambah panjang. Sekarang pembacaan baris
        # hanya dipicu saat data mentah mengandung baris baru (newline), yang
        # menandakan sebuah baris output benar-benar selesai/baru muncul --
        # atau saat ada baris yang sempat tergeser keluar layar (scroll),
        # yang tadinya SAMA SEKALI tidak pernah dibacakan.
        if '\n' not in text and '\r' not in text and not scrolled_lines:
            return

        lines_to_speak: List[str] = []

        # Baris yang sudah tergeser keluar layar diletakkan lebih dulu,
        # karena urutannya memang muncul sebelum baris yang masih terlihat.
        for line in scrolled_lines:
            if not line or self._is_prompt(line):
                continue
            lines_to_speak.append(strip_escapes(line).strip())

        start_row = min(pre_cursor_y, current_y)
        end_row = max(pre_cursor_y, current_y)
        for y in range(start_row, end_row + 1):
            line = self.get_line_at(y)
            if not line:
                continue
            # Heuristik prompt hanya diterapkan pada baris tempat kursor
            # SAAT INI berada (y == current_y) -- lihat catatan di
            # _is_prompt soal risiko salah membuang baris output biasa.
            if y == current_y and self._is_prompt(line):
                if line != self.last_prompt:
                    self.last_prompt = line
                continue
            lines_to_speak.append(strip_escapes(line).strip())

        combined = ". ".join(l for l in lines_to_speak if l)
        if combined and combined != self._last_spoken_line:
            self._last_spoken_line = combined
            self.speech.speak(combined, interrupt=True)

    # ----------------------------------------------------------------------
    # Manajemen Input Pengguna
    # ----------------------------------------------------------------------
    def _feedback_keystroke(self, data: bytes, announce_control: bool) -> bool:
        """Memberi umpan balik suara untuk satu potongan input yang diketik.

        Dipakai baik di mode interaktif/editor maupun mode shell biasa supaya
        pengalaman mengetik konsisten di kedua mode -- sebelumnya karakter
        yang diketik HANYA dibacakan satu per satu di mode editor; di shell
        biasa pengguna tidak mendapat umpan balik sama sekali saat mengetik
        (hanya dengar seluruh baris dibaca ulang berulang kali lewat
        update_buffer, yang berisik dan tidak konsisten).

        Mengembalikan True jika fungsi ini benar-benar membacakan SATU
        karakter yang diketik (bukan tombol kontrol/panah) -- dipakai oleh
        pemanggil untuk menahan update_buffer() agar tidak membacakannya
        dua kali (lihat _typed_feedback_pending).
        """
        if data in (b'\r', b'\n'):
            if announce_control:
                self.speech.speak("enter", interrupt=True, pitch=60)
            return False
        if data == b'\x1b':
            if announce_control:
                self.speech.speak("escape", interrupt=True, pitch=60)
            else:
                self.speech.stop_speaking()
            return False
        if data == b'\x03':
            self.speech.stop_speaking()
            return False
        # Jangan bacakan escape sequence mentah (panah, F-keys, dst) --
        # ini juga berarti navigasi panah TIDAK ditahan oleh
        # _typed_feedback_pending, sehingga update_buffer() tetap membacakan
        # karakter/kata tujuan navigasi seperti biasa.
        if data.startswith(b'\x1b['):
            return False

        try:
            char = data.decode('utf-8', errors='ignore')
        except UnicodeDecodeError:
            return False
        if len(char) == 1 and char.isprintable():
            self.speech.speak(char, interrupt=True, pitch=60, is_character=True)
            return True
        return False

    def _toggle_editor_mode_manual(self) -> None:
        """Memaksa masuk/keluar mode interaktif (editor_mode) secara MANUAL,
        dipicu dari Mode Pengaturan (Ctrl+S lalu E) -- lihat handle_input.

        Fitur diagnosis/uji coba: berbeda dari _detect_editor() yang
        otomatis bereaksi terhadap escape sequence alternate-screen-buffer
        yang dikirim aplikasi, fungsi ini murni perintah manual dari
        pengguna. Berguna sebagai jalan pintas ketika deteksi otomatis
        gagal bereaksi dengan benar (mis. saat wizard dialog seperti
        termux-change-repo berpindah tahap terlalu cepat -- lihat catatan
        panjang di _detect_editor) -- pengguna bisa memaksa status yang
        benar secara manual tanpa harus menunggu/bergantung pada perbaikan
        deteksi otomatis.
        """
        self.editor_mode = not self.editor_mode
        self._last_editor_cursor_y = self.screen.cursor.y
        self._last_editor_cursor_x = self.screen.cursor.x
        self._last_highlighted_row = None
        self._typed_feedback_pending = 0
        if self.editor_mode:
            self.speech.speak("mode interaktif diaktifkan secara manual", interrupt=True)
        else:
            self.speech.speak("mode interaktif dinonaktifkan secara manual", interrupt=True)

    def handle_input(self, master_fd: int, data: bytes) -> None:
        """Mengelola intersepsi tombol untuk fitur review dan input konvensional."""

        # Toggle Mode Pengaturan (Ctrl+S) -- diperiksa PALING AWAL, kapan
        # pun, termasuk saat sedang berada di Mode Penjelajahan, supaya
        # selalu bisa diakses sebagai kontrol darurat/diagnosis. Menekan
        # Ctrl+S TIDAK langsung mengeksekusi apa pun -- ia hanya
        # "mempersenjatai" (arm) mode ini dan menunggu perintah berikutnya.
        # (Aman dipakai: mode raw tty yang dipakai run() menonaktifkan
        # flow-control XON/XOFF, jadi byte Ctrl+S tidak lagi dicegat oleh
        # terminal/OS seperti pada mode kanonik lama.)
        if data == b'\x13':  # Ctrl+S
            self.setting_mode = not self.setting_mode
            if self.setting_mode:
                self.speech.speak(
                    "Mode pengaturan aktif. Tekan E untuk beralih mode "
                    "interaktif secara manual, atau Ctrl+S lagi untuk keluar.",
                    interrupt=True,
                )
            else:
                self.speech.speak("Mode pengaturan nonaktif", interrupt=True)
            return

        # Eksekusi Mode Pengaturan -- SELURUH input di sini TIDAK diteruskan
        # ke shell/aplikasi anak (persis seperti Mode Penjelajahan), supaya
        # perintah satu-huruf (mis. 'E') tidak bocor menjadi ketikan biasa
        # ke shell/aplikasi yang sedang berjalan.
        if self.setting_mode:
            if data in (b'e', b'E'):
                self._toggle_editor_mode_manual()
            # Tombol lain di dalam mode ini sengaja diabaikan (belum ada
            # perintah lain yang didefinisikan) -- tetap TIDAK diteruskan.
            return

        # Toggle Mode Penjelajahan (Ctrl+I / Tab)
        if data in (b'\x09', b'\t'):
            self.review_mode = not self.review_mode
            if self.review_mode:
                self.rx = self.screen.cursor.x
                self.ry = self.screen.cursor.y
                line = self.get_line_at(self.ry)
                utter = "Mode penjelajahan aktif. " + (line if line else "baris kosong")
                self.speech.speak(utter, interrupt=True)
            else:
                self.speech.speak("Mode penjelajahan nonaktif", interrupt=True)
            return

        # Eksekusi Mode Penjelajahan
        if self.review_mode:
            try:
                code = data.decode('utf-8', errors='ignore')
            except UnicodeDecodeError:
                return

            # Navigasi Baris
            if code == '\x1b[A':  # Atas
                if self.ry > 0:
                    self.ry -= 1
                    new_max = self.get_line_length(self.ry)
                    self.rx = min(self.rx, new_max - 1) if new_max > 0 else 0
                    line = self.get_line_at(self.ry)
                    self.speech.speak(line if line else "kosong")
                else:
                    self.speech.speak("atas")
            elif code == '\x1b[B':  # Bawah
                if self.ry < self.rows - 1:
                    self.ry += 1
                    new_max = self.get_line_length(self.ry)
                    self.rx = min(self.rx, new_max - 1) if new_max > 0 else 0
                    line = self.get_line_at(self.ry)
                    self.speech.speak(line if line else "kosong")
                else:
                    self.speech.speak("bawah")

            # Navigasi Karakter
            elif code == '\x1b[C':  # Kanan
                max_len = self.get_line_length(self.ry)
                if max_len > 0 and self.rx < max_len - 1:
                    self.rx += 1
                    self.speech.speak(self.get_char_at(self.rx, self.ry), is_character=True)
                elif max_len == 0:
                    self.speech.speak("baris kosong")
                else:
                    self.speech.speak("akhir baris")
            elif code == '\x1b[D':  # Kiri
                if self.rx > 0:
                    self.rx -= 1
                    self.speech.speak(self.get_char_at(self.rx, self.ry), is_character=True)
                else:
                    self.speech.speak("awal baris")

            # Navigasi Kata (Ctrl + Kanan / Ctrl + Kiri)
            elif code == '\x1b[1;5C':  # Ctrl + Kanan
                self.rx = self.find_next_word_x(self.rx, self.ry)
                word = self.get_word_at(self.rx, self.ry)
                self.speech.speak(word)
            elif code == '\x1b[1;5D':  # Ctrl + Kiri
                self.rx = self.find_prev_word_x(self.rx, self.ry)
                word = self.get_word_at(self.rx, self.ry)
                self.speech.speak(word)

            # Navigasi Home/End (awal dan akhir baris) -- sebelumnya tidak ada.
            elif code in ('\x1b[H', '\x1b[1~'):  # Home
                self.rx = 0
                self.speech.speak(self.get_char_at(self.rx, self.ry), is_character=True)
            elif code in ('\x1b[F', '\x1b[4~'):  # End
                length = self.get_line_length(self.ry)
                self.rx = max(0, length - 1)
                if length > 0:
                    self.speech.speak(self.get_char_at(self.rx, self.ry), is_character=True)
                else:
                    self.speech.speak("baris kosong")

            # Enter di mode penjelajahan: baca ulang baris saat ini.
            elif code in ('\r', '\n'):
                line = self.get_line_at(self.ry)
                self.speech.speak(line if line else "baris kosong", interrupt=True)

            elif data in (b'\x03', b'\x1b'):
                self.speech.stop_speaking()
            return

        # Manajemen Umpan Balik Pengetikan (Editor & Shell)

        # Intersepsi Backspace (Hapus karakter di KIRI kursor)
        if data in (b'\x7f', b'\x08'):
            target_x = self.screen.cursor.x - 1
            if target_x >= 0:
                deleted = self.get_char_at(target_x, self.screen.cursor.y)
                self.speech.speak(deleted, interrupt=True, pitch=80, is_character=True)
                self._typed_feedback_pending = min(self._typed_feedback_pending + 1, 5)
            else:
                self.speech.stop_speaking()
            os.write(master_fd, data)
            return

        # Intersepsi Delete (Hapus karakter TEPAT di kursor)
        if data == b'\x1b[3~':
            target_x = self.screen.cursor.x
            deleted = self.get_char_at(target_x, self.screen.cursor.y)
            self.speech.speak(deleted, interrupt=True, pitch=80, is_character=True)
            self._typed_feedback_pending = min(self._typed_feedback_pending + 1, 5)
            os.write(master_fd, data)
            return

        # Umpan balik Spasi (Membaca kata sebelumnya)
        if data == b' ':
            cursor_y, cursor_x = self.screen.cursor.y, self.screen.cursor.x
            line_prefix = "".join(
                self.screen.buffer[cursor_y][x].data for x in range(cursor_x)
            )
            words = line_prefix.strip().split()
            if words:
                self.speech.speak(words[-1], interrupt=False)
            self._typed_feedback_pending = min(self._typed_feedback_pending + 1, 5)
            os.write(master_fd, data)
            return

        # Umpan balik ketikan biasa (huruf, tanda baca, Enter, Escape, dst).
        # Sekarang seragam untuk mode editor maupun shell biasa.
        if self._feedback_keystroke(data, announce_control=self.editor_mode):
            self._typed_feedback_pending = min(self._typed_feedback_pending + 1, 5)
        os.write(master_fd, data)

    # ----------------------------------------------------------------------
    # Pembuatan PTY & Proses Anak (Shell)
    # ----------------------------------------------------------------------
    def _spawn_child(self) -> Tuple[int, int]:
        """Membuat PTY dan menjalankan shell di dalamnya.

        Sebelumnya kode ini memakai pty.fork(), yang telah dinyatakan usang
        (deprecated) oleh Python sejak versi 3.12 dan dijadwalkan dihapus.
        Di sini PTY dibuat secara eksplisit lewat pty.openpty() lalu proses
        anak dibuat lewat os.fork(), sehingga kode tetap berjalan pada versi
        Python yang lebih baru tanpa bergantung pada API yang usang.
        """
        master_fd, slave_fd = pty.openpty()
        self._set_pty_size(master_fd)

        pid = os.fork()
        if pid == 0:
            # --- Proses anak: menjadi shell interaktif ---
            os.close(master_fd)
            os.setsid()
            try:
                fcntl.ioctl(slave_fd, termios.TIOCSCTTY, 0)
            except OSError:
                pass

            os.dup2(slave_fd, 0)
            os.dup2(slave_fd, 1)
            os.dup2(slave_fd, 2)
            if slave_fd > 2:
                os.close(slave_fd)

            shell = os.environ.get('SHELL') or '/system/bin/sh'
            try:
                os.execvp(shell, [shell])
            except OSError:
                os._exit(1)
            os._exit(1)  # tidak akan tercapai, jaga-jaga saja

        # --- Proses induk (pembaca layar) ---
        os.close(slave_fd)
        return pid, master_fd

    # ----------------------------------------------------------------------
    # Siklus PTY Utama
    # ----------------------------------------------------------------------
    # Batas ukuran (byte) saat menggabungkan beberapa potongan data PTY yang
    # SUDAH tersedia sekaligus menjadi satu unit sebelum diproses -- lihat
    # catatan lengkap di run(). Cukup besar untuk redraw dialog TUI penuh
    # (biasanya hanya beberapa KB), tapi tetap dibatasi supaya perintah yang
    # menghasilkan aliran data terus-menerus (mis. `yes`, log yang sangat
    # aktif) tidak membuat pembacaan tertunda tanpa batas.
    _MAX_COALESCE_BYTES = 65536

    def run(self) -> None:
        """Memulai perulangan IO non-blocking untuk terminal pseudo."""
        print("=== Termux Screen Reader ===")
        print("Gunakan Ctrl+I / Tab untuk masuk/keluar Mode Penjelajahan.")
        print("Gunakan Ctrl+Kiri / Ctrl+Kanan untuk navigasi kata, Home/End untuk awal/akhir baris.")
        print("Gunakan Ctrl+S lalu E untuk memaksa mode interaktif secara manual (diagnosis).")
        print("Ketik 'exit' untuk mengakhiri sesi.\n")
        sys.stdout.flush()

        stdin_fd = sys.stdin.fileno()
        stdout_fd = sys.stdout.fileno()
        old_tty = termios.tcgetattr(stdin_fd)

        self.child_pid, self.master_fd = self._spawn_child()
        master_fd = self.master_fd

        try:
            tty.setraw(stdin_fd)
            while True:
                try:
                    r, _, _ = select.select([stdin_fd, master_fd], [], [])
                except InterruptedError:
                    # select() dapat diinterupsi oleh sinyal (mis. SIGWINCH).
                    continue

                if stdin_fd in r:
                    try:
                        data = os.read(stdin_fd, 1024)
                    except OSError:
                        break
                    if not data:
                        break
                    self.handle_input(master_fd, data)

                if master_fd in r:
                    try:
                        data = os.read(master_fd, 4096)
                    except OSError:
                        # PTY tertutup (mis. shell anak sudah keluar).
                        break
                    if not data:
                        break

                    # Kuras SEMUA data yang SUDAH tersedia saat ini tanpa
                    # menunggu (non-blocking, timeout=0) dan gabungkan
                    # menjadi SATU unit sebelum diproses.
                    #
                    # PENTING -- ini memperbaiki dua masalah sekaligus:
                    #   1) Saat sebuah aplikasi TUI menggambar ulang layar
                    #      penuh (mis. whiptail membuka dialog BARU setelah
                    #      pengguna menekan konfirmasi), penulisannya ke PTY
                    #      biasanya jauh lebih besar dari satu potongan
                    #      os.read() -- bila diproses TERPISAH per potongan,
                    #      update_buffer() akan sempat mengevaluasi kondisi
                    #      layar yang BARU SEPARUH tergambar sebagai kondisi
                    #      "final" yang keliru, lalu membacakannya -- inilah
                    #      sumber suara "banyak simbol acak dibacakan
                    #      beruntun" yang dilaporkan saat berpindah tampilan
                    #      (mis. masuk ke daftar pilihan mirror). Dengan
                    #      digabung dulu, update_buffer() hanya pernah
                    #      melihat kondisi layar yang sudah SELESAI digambar.
                    #   2) Menggabungkan potongan JUGA sangat mengurangi
                    #      peluang sekuens escape 8-9 karakter (mis.
                    #      "\x1b[?1049h") terpotong tepat di batas 4096-byte
                    #      antar panggilan read() -- lihat catatan panjang
                    #      di _detect_editor soal ini sebagai penyebab UTAMA
                    #      laporan "mode interaktif gagal setelah
                    #      konfirmasi". (_detect_editor tetap punya buffer
                    #      carry-over sendiri sebagai lapisan pertahanan
                    #      kedua untuk semburan yang melebihi batas di bawah.)
                    chunks = [data]
                    total = len(data)
                    while total < self._MAX_COALESCE_BYTES:
                        try:
                            ready, _, _ = select.select([master_fd], [], [], 0)
                        except InterruptedError:
                            break
                        if not ready:
                            break
                        try:
                            more = os.read(master_fd, 4096)
                        except OSError:
                            break
                        if not more:
                            break
                        chunks.append(more)
                        total += len(more)
                    if len(chunks) > 1:
                        data = b"".join(chunks)

                    os.write(stdout_fd, data)
                    self.update_buffer(data)

        finally:
            # shutdown() (bukan sekadar stop_speaking()) supaya proses TTS
            # latar belakang yang mungkin masih tersisa juga ikut dihentikan
            # dan di-reap saat sesi benar-benar berakhir.
            self.speech.shutdown()
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_tty)
            try:
                os.close(master_fd)
            except OSError:
                pass
            if self.child_pid:
                try:
                    os.kill(self.child_pid, signal.SIGHUP)
                except ProcessLookupError:
                    pass
                try:
                    os.waitpid(self.child_pid, 0)
                except ChildProcessError:
                    pass
            print("\r\n=== Sesi Berakhir ===")


if __name__ == '__main__':
    reader = TermuxScreenReader()
    reader.run()
